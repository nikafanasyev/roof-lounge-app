+          </div>
+          <div style={{ textAlign: "right" }}>
+            <div style={{ fontWeight: 700 }}>{money(s.salary)}</div>
+            <span className={`chip ${s.paid ? "" : "accent"}`}>{s.paid ? "выплачено" : "к выплате"}</span>
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}

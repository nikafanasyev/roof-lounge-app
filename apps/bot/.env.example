BOT_TOKEN=
MINI_APP_URL=https://your-miniapp-domain.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STAFF_CHAT_ID=
# Необязательно: отдельный чат для фото открытия/закрытия смены.
# Если не задать — фото падают в STAFF_CHAT_ID.
SHIFT_PHOTOS_CHAT_ID=

# Необязательно: статус смены заведения из Quick Resto (ПИН-вход сотрудника
# на терминале) вместо ручной кнопки "Открыть/закрыть смену" в приложении.
# Без QR_LOGIN/QR_PASSWORD интеграция просто не запускается.
QR_HOST=hu554.quickresto.ru
QR_LOGIN=
QR_PASSWORD=
QR_POLL_START_HOUR=10
QR_POLL_END_HOUR=8
QR_POLL_INTERVAL_MS=90000
